# LLM providers (free-tier)
GROQ_API_KEY=your_groq_api_key_here
# llama-3.1-8b-instant was decommissioned on Groq; gpt-oss-20b is verified working
GROQ_MODEL=openai/gpt-oss-20b

HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Encrypts user-added provider keys at rest. Optional: without it a local
# backend/.mars_secret key file is created automatically on first use.
MARS_SECRET_KEY=your_random_secret_here

# Custom OpenAI-compatible provider: leads the LLM chain when the full
# trio is set (anything starting with your_ counts as unset).
CUSTOM_LLM_API_KEY=your_custom_key_here
CUSTOM_LLM_BASE_URL=https://your-provider.example/v1
CUSTOM_LLM_MODEL=your-model-id-here

# Search providers
TAVILY_API_KEY=your_tavily_api_key_here

# Runtime constraints
DATABASE_URL=./research.db
MAX_PARALLEL_SEARCH=2
MAX_PARALLEL_AGENTS=3
# Concurrent LLM calls across the whole pipeline. Low by default: concurrent
# large prompts exhaust free-tier TPM/TPD quotas (Groq daily token limit).
MAX_PARALLEL_LLM=2
MAX_ITERATIONS=3
SEARCH_FETCH_TOP_N=8
SEARCH_MAX_QUERIES_PER_PASS=8
# v3 retrieval knobs (wired for the v3 search port; inert until then)
MAX_PARALLEL_FETCH=4
SEARCH_RETRY_ATTEMPTS=3
MAX_QUERIES_PER_CONTRACT=3
SEARCH_MAX_RESULTS=10
# Retrieval access hardening: hard-blocked (403/451) or repeatedly failing
# hosts cool down for this window so later passes stop re-hitting them.
# Transient fetch failures (429/timeout/5xx/connection) get bounded retries;
# 403 is never retried. Canonical URLs that failed this run are never
# re-fetched. The registry and failure memory are LRU-bounded.
SEARCH_DOMAIN_COOLDOWN_SEC=90
SEARCH_DOMAIN_FAILURE_THRESHOLD=3
SEARCH_DOMAIN_REGISTRY_MAX=512
SEARCH_FAILED_URL_MEMORY_MAX=2048
SEARCH_FETCH_RETRY_ATTEMPTS=2
SEARCH_PRIMARY_FALLBACK_ENABLED=true
SEARCH_PRIMARY_FALLBACK_MAX=2
# Hard cap on search results retained across expansion passes (oldest dropped).
SEARCH_MAX_RESULTS_RETAINED=80
# Hard per-run wall on the expansion loop (alongside MAX_ITERATIONS and the
# money/time budget): max expansion passes actually issued and max extra
# search queries those passes may issue. Bounds a broad deep query.
MAX_EXPANSION_PASSES=12
MAX_EXPANSION_SEARCHES=48
# Corroboration acquisition: bounded per-claim re-query attempts and the
# claim-vs-page similarity band at/above which a NEW publisher's text counts
# as independent corroboration.
MAX_CORROBORATION_ATTEMPTS=2
CORROBORATION_SIMILARITY=0.55
TAVILY_SEARCH_DEPTH=basic
# Research budget governor (v2: ENFORCED — every LLM call records tokens/cost
# into the per-run ledger; the depth controller refuses unaffordable passes)
MAX_BUDGET_USD=0.50
MAX_BUDGET_TOKENS=400000
MAX_LLM_CALLS=60
MAX_RESEARCH_SECONDS=300
STRICT_BUDGET=false
LLM_TIMEOUT_SEC=25
# Custom provider only: slower OpenAI-compatible hosts need 30-60s on
# planner-sized prompts and stall past 60s under load; a premature timeout
# trips the breaker and degrades runs. Worst case stays inside the research
# budget (90s custom + 25s groq, one pass, no timeout retries).
CUSTOM_LLM_TIMEOUT_SEC=90
SEARCH_TIMEOUT_SEC=20
RESEARCH_TIMEOUT_SEC=300

# Cache (diskcache, bounded)
CACHE_SIZE_LIMIT_BYTES=250000000
CACHE_TTL_SEC=3600

# LLM response cache (v2): exact-prompt disk cache. Repeated critic re-evals
# and re-runs are served in ~1ms with zero provider spend.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SEC=21600

# Citation validation (v2): live URL re-check of the sources the final
# answer cites. Bounded and never fatal — dead links become report warnings.
CITATION_CHECK_ENABLED=true
CITATION_CHECK_TIMEOUT_SEC=5
CITATION_CHECK_MAX=10

# When a UI-selected active provider FAILS (timeout, rate limit, outage),
# fall through to Groq/HF instead of degrading the run to extraction.
# false = strict exclusivity: a failing selection never spends another key.
ACTIVE_PROVIDER_FALLBACK=true

# Rate limiting (slowapi format) on /api/research/stream
RATE_LIMIT=5/minute

# Intent classification (understand-before-searching): resolves ambiguous
# queries ("transformer": AI model vs electrical device), sets the research
# domain and the explanation level before any planning happens.
INTENT_ENABLED=true

# Answer quality gate (final editor): the synthesized answer is scored 0-100
# on accuracy/relevance/evidence/clarity/reasoning from measured pipeline
# state; below-threshold answers get exactly one corrective re-synthesis and
# are disclosed either way.
QUALITY_GATE_ENABLED=true
QUALITY_THRESHOLD=70
# LLM revision pass: the writer always rewrites its draft once (fed the
# measured failures, or a polish mandate when the gate passed); the better-
# scoring draft ships. Disable to save one LLM call per run.
SYNTHESIS_REVISION_ENABLED=true

# Answer-first outline + section-wise synthesis (GPT Researcher parity). The
# report's section shape is derived from the query + evidence BEFORE writing;
# broad questions (3+ outline dimensions) are written one section at a time
# and assembled, so a broad query cannot collapse into one narrow thesis or a
# source dump. Degrades to the single-pass writer when disabled or on failure.
SYNTHESIS_OUTLINE_ENABLED=true
SYNTHESIS_SECTION_WISE_ENABLED=true
# Context compression: merge near-duplicate claims into one thematic entry
# before the writer sees them. Distinct claims are NEVER dropped.
SYNTHESIS_CONTEXT_COMPRESSION=true
SYNTHESIS_COMPRESSION_THRESHOLD=0.72

# Dynamic Research Depth (Phase 2.8)
SUFFICIENCY_THRESHOLD=0.75
MIN_MARGINAL_GAIN=0.03
MAX_RESEARCH_DEPTH=0