# LLM providers (free-tier)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# Search providers
TAVILY_API_KEY=your_tavily_api_key_here

# Runtime constraints
DATABASE_URL=./research.db
MAX_PARALLEL_SEARCH=2
MAX_PARALLEL_AGENTS=3
MAX_ITERATIONS=3
LLM_TIMEOUT_SEC=25
SEARCH_TIMEOUT_SEC=20
RESEARCH_TIMEOUT_SEC=90

# Cache (diskcache, bounded)
CACHE_SIZE_LIMIT_BYTES=250000000
CACHE_TTL_SEC=3600

# Rate limiting (slowapi format) on /api/research/stream
RATE_LIMIT=5/minute

# Cost governor (Phase 2.2) — per-run budget and provider $/1k-token rates
RESEARCH_MAX_COST_USD=0.50
GROQ_COST_PER_1K_INPUT_TOKENS=0.00005
GROQ_COST_PER_1K_OUTPUT_TOKENS=0.00008
HF_COST_PER_1K_TOKENS=0.0002